# ==============================================================================
# MEDSHIELD AI - Environment Configuration
# ==============================================================================

# Application environment: development | testing | production
APP_ENV=development
LOG_LEVEL=INFO

# Database configuration (defaults to local SQLite; supports PostgreSQL in cloud)
# Example PostgreSQL: postgresql+psycopg://medshield:securepass@localhost:5432/medshield_db
DATABASE_URL=sqlite:///./medshield.db

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-in-production

# Fetch.ai / Agentverse & Almanac Configuration
# Agent seeds must be unique 32+ character phrases
AGENT_SEED_COMMANDER=medshield_incident_commander_seed_phrase_demo_2026
AGENT_PORT_COMMANDER=8001
AGENTVERSE_API_KEY=
AGENT_MAILBOX_KEY=

# Sandbox Simulator Settings
SIMULATOR_ALLOW_ACTIONS=true
SIMULATOR_TICK_RATE_MS=500

# Operator Authorization Secret (used for signing approval decisions)
APPROVAL_SIGNING_SECRET=secure-incident-approval-hmac-key-2026
APPROVAL_EXPIRY_SECONDS=300

# Payment Agent Sandbox Configuration
PAYMENT_SANDBOX_MODE=true
PAYMENT_MAX_INSTITUTIONAL_LIMIT=25000.00
PAYMENT_CURRENCY=USD
